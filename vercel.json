{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/sanity/:path*",
      "destination": "https://z6ortijb.api.sanity.io/:path*"
    },
    {
      "source": "/api/vendure",
      "destination": "https://api.defendfreedomindustries.com/shop-api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}